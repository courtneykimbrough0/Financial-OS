rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidFinancialData(data, uid) {
      return data.keys().hasAll(['userId', 'schemaVersion', 'revision', 'onboardingComplete', 'sources', 'records'])
        && data.keys().hasOnly(['userId', 'schemaVersion', 'revision', 'onboardingComplete', 'sources', 'records', 'updatedAt'])
        && data.userId == uid
        && data.userId == request.auth.uid
        && data.schemaVersion is number
        && data.revision is number && data.revision >= 1
        && data.onboardingComplete is bool
        && data.sources is list && data.sources.size() <= 1000
        && data.records is list && data.records.size() <= 10000
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    match /financialData/{uid} {
      allow get: if isValidId(uid) && isOwner(uid);
      allow list: if false;

      allow create: if isValidId(uid)
        && isOwner(uid)
        && isValidFinancialData(incoming(), uid)
        && incoming().revision == 1;

      allow update: if isValidId(uid)
        && isOwner(uid)
        && isValidFinancialData(incoming(), uid)
        && incoming().userId == existing().userId
        && incoming().revision == existing().revision + 1
        && incoming().diff(existing()).affectedKeys().hasOnly(['schemaVersion', 'revision', 'onboardingComplete', 'sources', 'records', 'updatedAt']);

      allow delete: if isValidId(uid) && isOwner(uid);
    }
  }
}
