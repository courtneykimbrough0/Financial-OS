{
  "name": "financial-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Financial OS: mobile-first cash-flow forecasting PWA",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "dev:supabase": "vite --mode supabase-dev --host 127.0.0.1 --port 3000",
    "build": "tsc -b && vite build",
    "build:hosted-test": "tsc -b && vite build --mode supabase-hosted-test --outDir dist-hosted-test",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "tsc -b && eslint firestore.rules",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "VITE_ACCOUNTS=off vite build --outDir dist-e2e && node scripts/e2e-smoke.mjs dist-e2e",
    "test:db": "node scripts/test-db.mjs",
    "test:supabase": "node scripts/test-supabase.mjs",
    "e2e:supabase": "node scripts/e2e-supabase.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-financial-os \"vitest run --config vitest.rules.config.ts\"",
    "start": "node server.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "firebase": "^13.0.0",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "firebase-tools": "^15.33.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1"
  }
}
